{
  "name": "woodsmith-visual-audit",
  "version": "1.0.0",
  "description": "Deterministic two-mode visual archive for Beaman Woodworks",
  "scripts": {
    "test": "npm run build && node --test dist/*.test.js",
    "test:media-browser": "node scripts/verify-media-collections.mjs",
    "build": "tsc -p tsconfig.json",
    "capture": "npm run build && node dist/run.js",
    "report": "npm run build && node dist/report.js",
    "validate": "npm run build && node dist/validate.js",
    "compare": "npm run build && node dist/diff.js",
    "repair": "npm run build && node dist/repair.js",
    "benchmark:artifacts": "npm run build && node dist/benchmark-artifacts.js",
    "benchmark:browser-gpu": "npm run build && node dist/benchmark-browser-gpu.js",
    "benchmark:phases": "npm run build && node dist/benchmark-phases.js",
    "benchmark:validator": "npm run build && node dist/benchmark-validator.js",
    "all": "npm run capture && npm run compare && npm run report && npm run validate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": true,
  "dependencies": {
    "pdfkit": "0.19.1",
    "playwright": "1.61.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/pdfkit": "0.17.6",
    "typescript": "5.8.3"
  }
}
