{
  "name": "woodsmith-visual-audit",
  "version": "1.0.0",
  "description": "Deterministic two-mode visual archive for Beaman Woodworks",
  "scripts": {
    "test": "node ./node_modules/typescript/bin/tsc -p tsconfig.json && node --test dist/*.test.js",
    "test:media-browser": "node scripts/verify-media-collections.mjs",
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "capture": "node ./node_modules/typescript/bin/tsc -p tsconfig.json && node dist/run.js",
    "report": "node ./node_modules/typescript/bin/tsc -p tsconfig.json && node dist/report.js",
    "validate": "node ./node_modules/typescript/bin/tsc -p tsconfig.json && node dist/validate.js",
    "compare": "node ./node_modules/typescript/bin/tsc -p tsconfig.json && node dist/diff.js",
    "repair": "node ./node_modules/typescript/bin/tsc -p tsconfig.json && node dist/repair.js",
    "benchmark:artifacts": "node ./node_modules/typescript/bin/tsc -p tsconfig.json && node dist/benchmark-artifacts.js",
    "benchmark:browser-gpu": "node ./node_modules/typescript/bin/tsc -p tsconfig.json && node dist/benchmark-browser-gpu.js",
    "benchmark:phases": "node ./node_modules/typescript/bin/tsc -p tsconfig.json && node dist/benchmark-phases.js",
    "benchmark:special": "node ./node_modules/typescript/bin/tsc -p tsconfig.json && node dist/benchmark-special-stage.js",
    "benchmark:validator": "node ./node_modules/typescript/bin/tsc -p tsconfig.json && node dist/benchmark-validator.js",
    "all": "node ./node_modules/typescript/bin/tsc -p tsconfig.json && node dist/run.js && node dist/diff.js && node dist/report.js && node dist/validate.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": true,
  "dependencies": {
    "pdfkit": "0.19.1",
    "playwright": "1.61.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/pdfkit": "0.17.6",
    "typescript": "5.8.3"
  }
}
