# Synology user mapping
PUID=1026
PGID=100

# Public site URL used for password reset links, Stripe redirects, and share links
SITE_URL=https://beamanwoodworks.example.com
NEXT_PUBLIC_SITE_URL=https://beamanwoodworks.example.com

# Media library root. Synology production mounts the real photo library here:
# /volume1/homes/Cooper/Photos/Dad_Woodworking_09262025:/app/pics:rw
MEDIA_ROOT=/app/pics

# Studio access and session signing
STUDIO_PASSWORD=change-this-before-public
SESSION_SECRET=replace-with-a-long-random-secret

# Payment infrastructure
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Shipping labels
EASYPOST_API_KEY=
SHIP_FROM_NAME=Beaman Woodworks
SHIP_FROM_STREET1=
SHIP_FROM_CITY=
SHIP_FROM_STATE=
SHIP_FROM_ZIP=
SHIP_FROM_COUNTRY=US

# Email notifications
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# Optional AI services. Disabled by default; keep the API key server-side only.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=high
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_VISION_MODEL=gpt-4o-mini
ENABLE_PUBLIC_AI_RENDERING=false
ENABLE_AI_BACKGROUND_CLEANUP=false
ENABLE_EMBEDDING_SEARCH=false
ENABLE_AI_MEDIA_ANALYSIS=false
