# Synology user mapping
PUID=1026
PGID=100

# Public site URL used for password reset links, verification links, Stripe redirects, and share links
SITE_URL=https://woodmat.ch
NEXT_PUBLIC_SITE_URL=https://woodmat.ch

# Media library root. Synology production mounts the real photo library here:
# /volume1/homes/Cooper/Photos/Dad_Woodworking_09262025:/app/pics:rw
MEDIA_ROOT=/app/pics
# Persistent application data root. The Synology volume mounts this exact path.
DATA_ROOT=/app/site/data

# Studio access and session signing
# Use single quotes for literal secrets containing `$` so Docker Compose does not interpolate them.
STUDIO_PASSWORD=change-this-before-public
SESSION_SECRET=replace-with-a-long-random-secret

# Privacy-preserving visitor analytics. Generate VISITOR_HMAC_SECRET
# independently from SESSION_SECRET. If left empty, the application falls
# back to SESSION_SECRET; rotating either secret starts a new visitor cohort.
# Change VISITOR_HMAC_KEY_ID at the same time so retained cohorts remain clear.
VISITOR_HMAC_SECRET=
VISITOR_HMAC_KEY_ID=v1
# Local/private network traffic is excluded by default.
VISITOR_TRACK_INTERNAL=false

# Authenticated visual-audit inventory access.
# Generate independently from STUDIO_PASSWORD and SESSION_SECRET.
VISUAL_AUDIT_TOKEN=
VISUAL_AUDIT_MAX_RECORDS=5000
# Production must report the mounted library as production-live. Snapshot-lab
# and local-smoke runners override this with their isolated provenance.
WOODSMITH_MEDIA_PROVENANCE=production-live
# Strict execution policy: auto, cpu, or cuda. auto uses CUDA only after a
# representative benchmark has enabled a deterministic stage in this build.
VISUAL_AUDIT_ACCELERATOR=auto
# "auto" uses available CPU parallelism with conservative caps: capture 2,
# validation 6, and report 6. Explicit ranges are capture 1-6 and validation/report 1-8.
VISUAL_AUDIT_CAPTURE_WORKERS=auto
VISUAL_AUDIT_VALIDATION_WORKERS=auto
VISUAL_AUDIT_REPORT_WORKERS=auto

# Payment infrastructure
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Shipping labels
EASYPOST_API_KEY=
SHIP_FROM_NAME=Beaman Woodworks
SHIP_FROM_STREET1=
SHIP_FROM_CITY=
SHIP_FROM_STATE=
SHIP_FROM_ZIP=
SHIP_FROM_COUNTRY=US

# Email notifications
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Beaman Woodworks
SMTP_FROM_ADDRESS=

# Local-first media analysis. The Studio remains fully manual when the sidecar is offline.
AI_PROVIDER=local
AI_ANALYSIS_PROVIDER=local-sidecar
AI_EMBEDDING_PROVIDER=local-clip
AI_FALLBACK_PROVIDER=disabled
ENABLE_AI_MEDIA_ANALYSIS=true
ENABLE_EMBEDDING_SEARCH=true
ENABLE_LOCAL_IMAGE_EMBEDDINGS=true
ENABLE_GEMINI_FALLBACK=false
LOCAL_AI_SIDECAR_URL=http://127.0.0.1:8765
LOCAL_AI_SIDECAR_TOKEN=
LOCAL_EMBEDDING_MODEL=sentence-transformers/clip-ViT-B-32
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=gemma4
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
MEDIA_AI_MAX_BATCH=24
MEDIA_AI_REQUEST_TIMEOUT_MS=120000
MEDIA_AI_CONFIDENCE_HIGH=0.82
MEDIA_AI_CONFIDENCE_MIN=0.58
MEDIA_AI_AMBIGUITY_DELTA=0.08

# Optional media-ai-sidecar process values. Keep its cache outside the media tree.
MEDIA_AI_MEDIA_ROOT=
MEDIA_AI_CACHE=
MEDIA_AI_SIDECAR_TOKEN=
MEDIA_AI_HOST=127.0.0.1
MEDIA_AI_PORT=8765
MEDIA_AI_ACCELERATOR=auto
MEDIA_AI_CUDA_DEVICE=0
MEDIA_AI_GPU_MEMORY_LIMIT_MB=4096
MEDIA_AI_GPU_LEASE_FILE=
MEDIA_AI_EMBED_BATCH_SIZE=16
MEDIA_AI_MODEL_LOCAL_ONLY=false
MEDIA_AI_USE_OLLAMA=false
MEDIA_AI_CLUSTER_SIMILARITY=0.84
MEDIA_AI_DUPLICATE_HASH_DISTANCE=8

# Optional backwards-compatible OpenAI services. Keep the API key server-side only.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=high
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_VISION_MODEL=gpt-5.4-nano
ENABLE_PUBLIC_AI_RENDERING=false
ENABLE_AI_BACKGROUND_CLEANUP=false
