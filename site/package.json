  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.24.0",
    "eslint-config-next": "16.0.0",
    "typescript": "5.8.3"
  }
}
